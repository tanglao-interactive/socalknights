---
layout: layouts/page.njk
title: Announcements
eyebrow: Chapter news
intro: Timely notices, deadlines, and updates for councils and members.
headerTheme: news
permalink: /announcements/
---
<section class="announcements-section" aria-labelledby="current-announcements">
  <h2 id="current-announcements">Current and upcoming</h2>
  {% if collections.currentAnnouncements.length %}
  <div class="announcement-list">
    {% for item in collections.currentAnnouncements %}
      {% include "components/announcement-card.njk" %}
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state"><p>No current or upcoming announcements have been posted.</p></div>
  {% endif %}
</section>
<section class="announcements-section" aria-labelledby="archived-announcements">
  <h2 id="archived-announcements">Archived</h2>
  {% if collections.archivedAnnouncements.length %}
  <div class="announcement-list">
    {% for item in collections.archivedAnnouncements %}
      {% include "components/announcement-card.njk" %}
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state"><p>No archived announcements.</p></div>
  {% endif %}
</section>
