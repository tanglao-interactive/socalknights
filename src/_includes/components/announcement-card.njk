<article class="announcement-card">{% if item.data.image %}<a class="announcement-card-image" href="{{ item.url }}"><img src="{{ item.data.image }}" alt="{{ item.data.imageAlt }}" loading="lazy" width="{{ item.data.imageWidth }}" height="{{ item.data.imageHeight }}"></a>{% endif %}<div class="announcement-card-copy"><time datetime="{{ item.data.date }}">{{ item.data.dateDisplay }}</time><h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3><p>{{ item.data.summary }}</p><a class="text-link" href="{{ item.url }}">Read the announcement <span aria-hidden="true">→</span></a></div></article>
