---
layout: layouts/page.njk
title: Events
eyebrow: Chapter calendar
intro: Gatherings, programs, deadlines, and service opportunities from across the Chapter.
headerTheme: events
permalink: /events/
---
{% if collections.upcomingEvents.length %}<section class="events-section"><div class="events-heading"><p class="eyebrow">Upcoming</p><h2>Save the date.</h2></div><div class="event-list">{% for event in collections.upcomingEvents %}<article class="event-feature"><a class="event-feature-image" href="{{ event.url }}"><img src="{{ event.data.image }}" alt="{{ event.data.imageAlt }}" loading="lazy" width="1122" height="1402"></a><div class="event-feature-copy"><time datetime="{{ event.data.date }}">{{ event.data.dateDisplay }}</time><h2><a href="{{ event.url }}">{{ event.data.title }}</a></h2><p class="event-location"><strong>{{ event.data.venue }}</strong><br>{{ event.data.city }}</p><p>{{ event.data.summary }}</p><a class="text-link" href="{{ event.url }}">View event details <span aria-hidden="true">→</span></a></div></article>{% endfor %}</div></section>{% else %}<div class="empty-state"><h2>No upcoming events have been posted.</h2><p>Chapter events and important dates will appear here as soon as they are confirmed.</p></div>{% endif %}
{% if collections.pastEvents.length %}<section><h2>Past events</h2>{% for event in collections.pastEvents %}<p><a href="{{ event.url }}">{{ event.data.title }}</a> — {{ event.data.date | eventDate }}</p>{% endfor %}</section>{% endif %}
